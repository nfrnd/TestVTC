---
// Two-step quote form. Without JavaScript every field is shown and the form
// posts to /api/demandes (POST, never GET) with native browser validation; the
// server answers with a summary page (demo) or a result page (live).
// With JavaScript: steps, conditional fields, recap, field errors, single
// submission, and (demo) a "fictional example" filler.
import { content, isDemo, passengerLimit, services } from '../../content';
import type { Lang } from '../../content/types';
import { t } from '../../i18n';
import { routes } from '../../i18n/routes';
import { LIMITS } from '../../lib/validation';
import Field from './Field.astro';
import FormStatus from './FormStatus.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const q = d.quote;
const max = passengerLimit();
const capped = content.vehicle.maxPassengers.known;
const hourlyService = services.find((s) => s.hourly);
const minHours = hourlyService?.hourly?.minHours ?? 1;
const channels = content.contactChannels;
const channelLabel = { email: q.byEmail, phone: q.byPhone, whatsapp: q.whatsapp };
const clientConfig = {
  lang,
  kind: 'devis',
  demo: isDemo,
  services: services.map((s) => ({ id: s.id, title: s.title[lang], hourly: s.hourly ?? null, travelRef: Boolean(s.travelRef) })),
  routes: content.fares.routes.map((r) => ({ id: r.id, serviceId: r.serviceId, from: r.from, to: r.to })),
  maxPassengers: max,
  channels,
  example: content.demo?.example ?? null,
  errors: d.errors,
  fieldErrors: d.fieldErrors,
  status: d.status,
  labels: {
    sending: q.sending, recapPassengers: q.recapPassengers, recapPassenger: q.recapPassenger, preselected: q.preselected,
    timeTbd: q.timeTbd, phone: q.phone, whatsapp: q.whatsapp, fareReference: q.fareReference, reference: q.reference,
    resultTitle: q.resultTitle, resultIntro: q.resultIntro, copied: q.copied, copyFailed: q.copyFailed, summary: q.summary,
  },
};
const opt = `(${q.optional})`;
---

<form class="qform" action="/api/demandes" method="post" data-form="devis" data-config={JSON.stringify(clientConfig)} aria-labelledby="form-title">
  <input type="hidden" name="kind" value="devis" />
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="requestId" value="" />
  <div class="hp" aria-hidden="true">
    <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  {q.notice && <p class="qform__notice" role="note">{q.notice}</p>}

  <p class="qform__progress" data-progress hidden>
    <span data-progress-text>{q.stepLabel} 1 {q.of} 2</span>
    <span class="qform__bar" aria-hidden="true"><span data-progress-bar></span></span>
  </p>

  <fieldset class="qform__step" data-step="1">
    <legend class="h-md">{q.step1}</legend>
    <p class="qform__preselected" data-preselected hidden></p>

    <div class="field">
      <label class="label" for="f-service">{q.service}</label>
      <select class="input" id="f-service" name="service" aria-describedby="e-service" data-service-select>
        <option value="">{q.serviceNone}</option>
        {services.map((s) => <option value={s.id}>{s.title[lang]}</option>)}
      </select>
      <p class="error" id="e-service" data-error-for="service"></p>
    </div>

    <Field name="departure" label={q.from} hint={q.fromHint} required maxlength={LIMITS.place[1]} minlength={LIMITS.place[0]} autocomplete="off" />
    <div data-when-not="hourly">
      <Field name="arrival" label={q.to} hint={q.toHint} maxlength={LIMITS.place[1]} minlength={LIMITS.place[0]} autocomplete="off" />
    </div>

    <div class="field-row">
      <Field name="date" label={q.date} type="date" required />
      <Field name="time" label={q.time} type="time" hint={q.timeHint} />
    </div>
    <label class="check"><input type="checkbox" name="timeTbd" value="on" data-time-tbd /> {q.timeTbd}</label>

    <div class="field-row">
      <div class="field">
        <label class="label" for="f-passengers">{q.passengers}</label>
        {capped ? (
          <select class="input" id="f-passengers" name="passengers" aria-describedby="h-passengers e-passengers" required>
            {Array.from({ length: max }, (_, i) => <option value={String(i + 1)} selected={i === 0}>{i + 1}</option>)}
          </select>
        ) : (
          <input class="input" id="f-passengers" name="passengers" type="number" min="1" max={max} value="1" inputmode="numeric" required aria-describedby="e-passengers" />
        )}
        {capped && <p class="hint" id="h-passengers" data-passengers-hint hidden>{q.passengersHintMax}</p>}
        <p class="error" id="e-passengers" data-error-for="passengers"></p>
      </div>
      <div class="field">
        <label class="label" for="f-luggage">{q.luggage}</label>
        <select class="input" id="f-luggage" name="luggage" aria-describedby="e-luggage">
          <option value="">{q.luggageTbd}</option>
          <option value="none">{q.luggageNone}</option>
          <option value="small">{q.luggageSmall}</option>
          <option value="one">{q.luggageOne}</option>
          <option value="two">{q.luggageTwo}</option>
        </select>
        <p class="error" id="e-luggage" data-error-for="luggage"></p>
      </div>
    </div>
    <Field name="luggageDetail" label={q.luggageDetail} hint={q.luggageDetailHint} maxlength={LIMITS.luggageDetail[1]} optional={q.optional} />

    <div data-when-not="hourly">
      <fieldset class="field choices-field">
        <legend class="label">{q.tripType}</legend>
        <div class="choices">
          <label class="choice"><input type="radio" name="tripType" value="oneway" checked /> {q.oneWay}</label>
          <label class="choice"><input type="radio" name="tripType" value="return" /> {q.roundTrip}</label>
        </div>
        <p class="error" data-error-for="tripType"></p>
      </fieldset>
      <div class="field-row" data-when="return">
        <Field name="returnDate" label={q.returnDate} type="date" />
        <Field name="returnTime" label={q.returnTime} type="time" hint={q.timeHint} />
      </div>
    </div>

    {hourlyService && (
      <div data-when="hourly">
        <Field name="duration" label={q.duration} type="number" min={minHours} max="24" inputmode="numeric" hint={q.durationHint.replace('{hours}', String(minHours))} />
        <Field name="program" label={`${q.program} ${opt}`} textarea maxlength={LIMITS.program[1]} />
      </div>
    )}

    <div data-when="travelref">
      <Field name="travelRef" label={q.travelRef} maxlength={LIMITS.travelRef[1]} autocomplete="off" />
    </div>

    <div class="qform__nav" data-step-nav hidden>
      <button class="btn btn--primary" type="button" data-next>{q.next}</button>
      {isDemo && <button class="btn btn--ghost" type="button" data-example>{q.example}</button>}
    </div>
  </fieldset>

  <fieldset class="qform__step" data-step="2">
    <legend class="h-md">{q.step2}</legend>
    <div class="recap" data-recap hidden>
      <div>
        <p class="recap__title">{q.recapTitle}</p>
        <p class="recap__body" data-recap-body></p>
      </div>
      <button class="btn btn--ghost recap__edit" type="button" data-back>{q.back}</button>
    </div>
    <Field name="name" label={q.name} required autocomplete="name" maxlength={LIMITS.name[1]} minlength={LIMITS.name[0]} />
    <fieldset class="field choices-field">
      <legend class="label">{q.contactMethod}</legend>
      <div class="choices">
        {channels.map((c, i) => <label class="choice"><input type="radio" name="contactMethod" value={c} checked={i === 0} /> {channelLabel[c]}</label>)}
      </div>
      <p class="error" data-error-for="contactMethod"></p>
    </fieldset>
    <div class="field-row">
      <div data-when="email"><Field name="email" label={q.email} type="email" autocomplete="email" inputmode="email" maxlength={LIMITS.email[1]} /></div>
      <div data-when="phone"><Field name="phone" label={q.phone} type="tel" autocomplete="tel" inputmode="tel" maxlength={LIMITS.phone[1]} hint={q.phoneHint} /></div>
    </div>
    <Field name="details" label={q.message} hint={q.messageHint} textarea maxlength={LIMITS.details[1]} />

    <p class="privacy-note">{q.privacy} <a href={routes.privacy[lang]}>{q.privacyLink}</a></p>
    <div class="qform__nav">
      <button class="btn btn--primary" type="submit" data-submit>{q.submit}</button>
    </div>
  </fieldset>

  <FormStatus lang={lang} kind="devis" />
</form>

<script>
  import { enhanceForms } from '../../scripts/forms';
  enhanceForms();
</script>

<style>
  .qform { display: grid; gap: 2rem; }
  .qform__notice { padding: 0.75rem 1rem; border-radius: var(--radius); background: rgb(29 81 72 / 0.09); color: var(--accent-deep); font-weight: 600; font-size: 0.95rem; }
  .qform__step { border: 0; margin: 0; padding: 0; min-width: 0; }
  .qform__step > legend { padding: 0; margin-bottom: 1.5rem; }
  .qform__progress { display: grid; gap: 0.5rem; font-size: 0.9rem; font-weight: 600; color: var(--ink-dark-soft); }
  .qform__bar { height: 4px; border-radius: 4px; background: rgb(17 25 29 / 0.1); overflow: hidden; }
  .qform__bar span { display: block; height: 100%; width: 50%; background: var(--accent-deep); border-radius: inherit; transition: width 300ms var(--ease); }
  .qform__nav { margin-top: 2rem; display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .qform__preselected { margin-bottom: 1.25rem; font-weight: 500; }
  .check { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; margin-top: 0.5rem; font-weight: 500; cursor: pointer; }
  .check input { width: 1.15rem; height: 1.15rem; accent-color: var(--accent-deep); }
  .choices-field { border: 0; padding: 0; margin: 1.25rem 0 0; }
  .qform :global(.field-row) + :global(.field), .qform :global(.field) + :global(.field-row), [data-when], [data-when-not] { margin-top: 1.25rem; }
  .recap { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; padding: 1rem 1.15rem; margin-bottom: 1.5rem; border-radius: var(--radius); background: #fff; border: 1px solid rgb(17 25 29 / 0.1); }
  .recap__title { font-weight: 600; font-size: 0.9rem; color: var(--ink-dark-soft); }
  .recap__body { font-weight: 500; }
  .recap__edit { --b-fg: var(--accent-deep); --b-bd: rgb(29 81 72 / 0.4); min-height: 2.75rem; }
  .privacy-note { margin-top: 1.5rem; font-size: 0.92rem; color: var(--ink-dark-soft); }
  .privacy-note a { color: var(--accent-deep); font-weight: 600; }
  /* Enhanced mode: one step at a time, conditional groups. */
  :global(.qform.is-enhanced[data-current='1']) [data-step='2'],
  :global(.qform.is-enhanced[data-current='2']) [data-step='1'] { display: none; }
  :global(.qform.is-done) > :not([data-status]) { display: none; }
  :global(.qform.is-enhanced) [data-off] { display: none; }
</style>
