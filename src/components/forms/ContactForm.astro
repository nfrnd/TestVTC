---
import { content } from '../../content';
import type { Lang } from '../../content/types';
import { t } from '../../i18n';
import { routes } from '../../i18n/routes';
import { LIMITS } from '../../lib/validation';
import Field from './Field.astro';
import FormStatus from './FormStatus.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const q = d.quote;
const channels = content.contactChannels;
const channelLabel = { email: q.byEmail, phone: q.byPhone, whatsapp: q.whatsapp };
const clientConfig = { lang, kind: 'contact', demo: Boolean(content.demo), channels, errors: d.errors, fieldErrors: d.fieldErrors, status: d.status, labels: { sending: q.sending, phone: q.phone, whatsapp: q.whatsapp } };
---

<form class="cform" action="/api/demandes" method="post" data-form="contact" data-config={JSON.stringify(clientConfig)} aria-labelledby="contact-form-title">
  <input type="hidden" name="kind" value="contact" />
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="requestId" value="" />
  <div class="hp" aria-hidden="true">
    <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>
  {q.notice && <p class="cform__notice" role="note">{q.notice}</p>}
  <Field name="name" label={q.name} required autocomplete="name" maxlength={LIMITS.name[1]} minlength={LIMITS.name[0]} />
  <fieldset class="field choices-field">
    <legend class="label">{q.contactMethod}</legend>
    <div class="choices">
      {channels.map((c, i) => <label class="choice"><input type="radio" name="contactMethod" value={c} checked={i === 0} /> {channelLabel[c]}</label>)}
    </div>
    <p class="error" data-error-for="contactMethod"></p>
  </fieldset>
  <div class="field-row">
    <div data-when="email"><Field name="email" label={q.email} type="email" autocomplete="email" inputmode="email" maxlength={LIMITS.email[1]} /></div>
    <div data-when="phone"><Field name="phone" label={q.phone} type="tel" autocomplete="tel" inputmode="tel" maxlength={LIMITS.phone[1]} hint={q.phoneHint} /></div>
  </div>
  <Field name="message" label={d.contact.message} textarea required maxlength={LIMITS.message[1]} minlength={LIMITS.message[0]} />
  <p class="privacy-note">{q.privacy} <a href={routes.privacy[lang]}>{q.privacyLink}</a></p>
  <div class="cform__nav">
    <button class="btn btn--primary" type="submit" data-submit>{d.contact.submit}</button>
  </div>
  <FormStatus lang={lang} kind="contact" />
</form>

<script>
  import { enhanceForms } from '../../scripts/forms';
  enhanceForms();
</script>

<style>
  .cform { display: grid; }
  .cform__notice { margin-bottom: 1.25rem; padding: 0.75rem 1rem; border-radius: var(--radius); background: rgb(29 81 72 / 0.09); color: var(--accent-deep); font-weight: 600; font-size: 0.95rem; }
  .choices-field { border: 0; padding: 0; margin: 1.25rem 0 0; }
  .cform :global(.field-row) { margin-top: 1.25rem; }
  .cform :global(.field-row) + :global(.field) { margin-top: 1.25rem; }
  .privacy-note { margin-top: 1.5rem; font-size: 0.92rem; color: var(--ink-dark-soft); }
  .privacy-note a { color: var(--accent-deep); font-weight: 600; }
  .cform__nav { margin-top: 1.5rem; }
  :global(.cform.is-done) > :not([data-status]) { display: none; }
  .cform :global([data-status]) { margin-top: 1.25rem; }
  :global(.cform.is-enhanced) [data-off] { display: none; }
</style>
