---
interface Props {
  title: string;
  lede?: string;
  eyebrow?: string;
}
const { title, lede, eyebrow } = Astro.props;
---

<header class="page-head ground-dark">
  <div class="wrap">
    {eyebrow && <p class="eyebrow" style="margin-bottom:1rem">{eyebrow}</p>}
    <h1 class="h-xl">{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</header>
