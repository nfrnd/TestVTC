---
import { business, isDemo } from '../../content';
import { known, type Lang } from '../../content/types';
import { t } from '../../i18n';
import { routes } from '../../i18n/routes';
import { resolveImage } from '../../lib/images';
import PreviewNote from '../PreviewNote.astro';
import { isPreview } from '../../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const name = known(business.driver.name);
const bio = known(business.driver.bio);
const languages = known(business.languages);
const hours = known(business.hours);
const photoRef = known(business.driver.photo);
const photo = photoRef ? resolveImage(photoRef.src) : null;
---

<section id="chauffeur" class="driver section ground-dark" aria-labelledby="driver-title">
  <div class="wrap driver__grid">
    {(photo || isPreview) && (
      <figure class="driver__photo" data-sc-in>
        {photo && photoRef ? (
          <img src={photo.src} srcset={photo.srcset} sizes="(min-width: 900px) 34vw, 22rem" width={photo.width} height={photo.height} alt={photoRef.alt[lang]} loading="lazy" decoding="async" />
        ) : (
          <div class="driver__placeholder"><PreviewNote lang={lang} note={d.driver.photoPending} /></div>
        )}
        {photo && isDemo && <figcaption>{lang === 'fr' ? 'Portrait généré par IA, personnage fictif.' : 'AI-generated portrait, fictional character.'}</figcaption>}
      </figure>
    )}
    <div class="driver__text stack" data-sc-in data-sc-stagger="60">
      <p class="eyebrow">{d.nav.driver}</p>
      <h2 id="driver-title" class="h-lg">{d.driver.title}</h2>
      {bio ? (
        <>
          {d.driver.intro && <p class="lede">{d.driver.intro}</p>}
          <p class="soft driver__bio">{bio[lang]}</p>
          {d.driver.signature && <p class="driver__signature">{d.driver.signature}</p>}
        </>
      ) : (
        <>
          <p class="lede soft">{d.driver.body}</p>
          <PreviewNote lang={lang} note={lang === 'fr' ? 'prénom et présentation validés par le chauffeur' : 'first name and bio approved by the driver'} />
        </>
      )}
      <dl class="driver__facts">
        <div><dt>{d.driver.base}</dt><dd>{business.city.value}</dd></div>
        <div><dt>{d.driver.languages}</dt><dd>{languages ? languages[lang] : <PreviewNote lang={lang} note="" />}</dd></div>
        <div><dt>{d.driver.hours}</dt><dd>{hours ? hours[lang] : <PreviewNote lang={lang} note="" />}</dd></div>
      </dl>
      {name && <p class="driver__cta"><a class="btn btn--primary" href={routes.contact[lang]}>{d.cta.contactDriver}</a></p>}
    </div>
  </div>
</section>

<style>
  .driver__grid { display: grid; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  @media (min-width: 900px) { .driver__grid:has(.driver__photo) { grid-template-columns: minmax(16rem, 0.75fr) 1.25fr; } }
  .driver__photo { margin: 0; display: grid; gap: 0.6rem; }
  .driver__photo img, .driver__placeholder { width: 100%; height: auto; aspect-ratio: 4 / 5; border-radius: calc(var(--radius) + 6px); object-fit: cover; }
  .driver__photo figcaption { font-size: 0.82rem; color: var(--sc-ink-soft); }
  .driver__placeholder { display: grid; place-items: center; padding: 1.5rem; border: 1px dashed rgb(244 246 244 / 0.25); background: repeating-linear-gradient(135deg, rgb(244 246 244 / 0.03) 0 12px, transparent 12px 24px); }
  @media (max-width: 899px) { .driver__photo { max-width: 24rem; } .driver__placeholder { aspect-ratio: 3 / 2; } }
  .driver__text { max-width: 46rem; }
  .driver__bio { max-width: 60ch; }
  .driver__signature { font-family: var(--sc-font-display); font-weight: 600; color: var(--sc-accent); }
  .driver__facts { margin: 2rem 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 1.25rem 2rem; border-top: 1px solid rgb(244 246 244 / 0.12); padding-top: 1.5rem; }
  .driver__facts dt { font-size: 0.82rem; color: var(--sc-ink-soft); letter-spacing: 0.04em; }
  .driver__facts dd { margin: 0.2rem 0 0; font-weight: 600; }
  .driver__facts div:has(dd:empty) { display: none; }
  .driver__cta { margin-top: 1.75rem; }
</style>
