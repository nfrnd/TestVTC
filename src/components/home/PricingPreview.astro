---
import type { Lang } from '../../content/types';
import { t } from '../../i18n';
import { routes, quoteHref } from '../../i18n/routes';
import FaresTable from '../FaresTable.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
---

<section class="pricing section ground-light" aria-labelledby="pricing-title">
  <div class="wrap pricing__grid">
    <div class="stack" data-sc-in data-sc-stagger="60">
      <h2 id="pricing-title" class="h-lg">{d.fares.title}</h2>
      <p class="lede soft">{d.fares.intro}</p>
      <div class="btn-row" style="margin-top:1.75rem">
        <a class="btn btn--primary" href={quoteHref(lang)}>{d.cta.quote}</a>
        <a class="text-link" href={routes.rates[lang]}>{d.fares.conditions}</a>
      </div>
    </div>
    <FaresTable lang={lang} />
  </div>
</section>

<style>
  .pricing__grid { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (min-width: 1100px) { .pricing__grid { grid-template-columns: 0.8fr 1.2fr; } }
</style>
