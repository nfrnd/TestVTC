---
// Hero. Two compositions, one loaded per viewport (media-conditioned <picture>):
//  - LAYERED (wide landscape screens): clean plate without car + transparent car,
//    same 1672x941 frame, same fit. Short Scroll Craft `pin`: a restrained
//    camera push-in where the car grows three times faster than the background
//    (x1.09 vs x1.03), both scaled around the front tyre's contact point
//    (69 %, 89 %) so it never floats and its wheels never "turn".
//  - STACKED (phones, tablets, narrow windows): text first, then ONE complete
//    photo (portrait photo cropped 4:3 from the bottom on phones; full
//    landscape photo on tablets). The car stays whole.
// Copy and actions are real HTML and never move.
import bg from '../../assets/azurea/hero-background.webp?url';
import bg960 from '../../assets/azurea/hero-background-960.webp?url';
import car from '../../assets/azurea/hero-car-alpha.webp?url';
import car960 from '../../assets/azurea/hero-car-alpha-960.webp?url';
import desk from '../../assets/azurea/hero-desktop.webp?url';
import desk960 from '../../assets/azurea/hero-desktop-960.webp?url';
import mob from '../../assets/azurea/hero-mobile.webp?url';
import mob720 from '../../assets/azurea/hero-mobile-720.webp?url';
import type { Lang } from '../../content/types';
import { t } from '../../i18n';
import { quoteHref } from '../../i18n/routes';
import ContactAction from '../ContactAction.astro';
import PreviewNote from '../PreviewNote.astro';
import { phone } from '../../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const tel = phone();

const LAYERED = '(min-width: 1100px) and (min-aspect-ratio: 3/2)';
const FRAME_SIZES = '(min-aspect-ratio: 2/1) 199vh, (min-aspect-ratio: 16/9) 100vw, 178vh';
const PIXEL = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
const bgSet = `${bg960} 960w, ${bg} 1672w`;
const carSet = `${car960} 960w, ${car} 1672w`;
const mobSet = `${mob720} 720w, ${mob} 1122w`;
const deskSet = `${desk960} 960w, ${desk} 1672w`;
---

<section class="hero" data-sc-act="pin" data-sc-span="1.4" data-hero aria-labelledby="hero-title">
  <div class="hero__stage" data-sc-stage data-sc-verify-state="1.000">
    <div class="hero__media" role="img" aria-label={d.hero.artLabel}>
      <div class="hero__frame">
        <picture class="hero__layer hero__layer--bg">
          <source media={LAYERED} srcset={bgSet} sizes={FRAME_SIZES} type="image/webp" />
          <img src={PIXEL} alt="" width="1672" height="941" fetchpriority="high" decoding="async" />
        </picture>
        <picture class="hero__layer hero__layer--car">
          <source media={LAYERED} srcset={carSet} sizes={FRAME_SIZES} type="image/webp" />
          <img src={PIXEL} alt="" width="1672" height="941" decoding="async" />
        </picture>
      </div>
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="hero__copy wrap">
      <div class="hero__head">
        <p class="eyebrow hero__eyebrow">{d.hero.eyebrow}</p>
        <h1 id="hero-title" class="hero__title">{d.hero.title}</h1>
        {d.hero.signature && <p class="hero__signature">{d.hero.signature}</p>}
      </div>
      <p class="lede hero__lede">{d.hero.lede}</p>
      <div class="btn-row hero__actions" data-hero-actions>
        <a class="btn btn--primary" href={quoteHref(lang)}>{d.cta.quote}</a>
        <ContactAction kind="call" lang={lang} class="btn btn--ghost" />
      </div>
      {d.hero.facts.length > 0 && <ul class="hero__facts">{d.hero.facts.map((f) => <li>{f}</li>)}</ul>}
      {!tel && <p class="hero__pv"><PreviewNote lang={lang} note={lang === 'fr' ? 'bouton « Appeler » affiché dès que le numéro est confirmé' : '“Call” button shown once the number is confirmed'} /></p>}
    </div>

    <figure class="hero__photo">
      <picture>
        <source media={LAYERED} srcset={PIXEL} />
        <source media="(max-width: 760px)" srcset={mobSet} sizes="100vw" type="image/webp" width="1122" height="1402" />
        <img src={desk960} srcset={deskSet} sizes="100vw" width="1672" height="941" alt={d.hero.artLabel} decoding="async" fetchpriority="high" />
      </picture>
    </figure>
    <p class="hero__caption">{d.hero.caption}</p>
  </div>
</section>

<style>
  .hero { position: relative; background: var(--sc-canvas); }

  /* ---------- STACKED (default): phones, tablets, narrow windows ---------- */
  .hero__media, .hero__scrim { display: none; }
  .hero__copy { position: relative; z-index: 2; padding-top: calc(var(--header-h) + var(--demo-h) + env(safe-area-inset-top) + clamp(1rem, 4vw, 2.5rem)); padding-bottom: 1.5rem; display: grid; gap: 0.9rem; justify-items: start; }
  .hero__title { font-size: clamp(2.2rem, 1.3rem + 4.4vw, 3.6rem); line-height: 1.02; max-width: 15ch; }
  .hero__signature { font-family: var(--sc-font-display); font-size: clamp(1.1rem, 1rem + 0.6vw, 1.4rem); color: var(--sc-accent); }
  .hero__lede { color: #dfe7e5; max-width: 38rem; }
  .hero__actions { margin-top: 0.4rem; }
  .hero__facts { list-style: none; margin: 0.2rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; font-size: 0.92rem; color: var(--sc-ink-soft); }
  .hero__facts li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .hero__facts li::before { content: ''; width: 0.35rem; height: 0.35rem; border-radius: 50%; background: var(--sc-accent); }
  .hero__photo { margin: 0; position: relative; }
  .hero__photo img { width: 100%; height: auto; }
  .hero__caption { position: absolute; right: var(--sc-gutter); bottom: 0.75rem; z-index: 3; margin: 0; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: #f4f6f4; background: rgb(17 25 29 / 0.62); }

  /* The head (eyebrow, title, signature) is only a layout group on phones. */
  .hero__head { display: contents; }

  /* ---------- PHONES: the whole portrait photo, title in its sky ----------
     Kit option 2 ("photo complète dans son ratio, texte court dans sa partie
     supérieure"). The photo sits under the floating header; its sky fades into
     the dark ground at the top, and the title lives in that fade, well above
     the car's roof (car top ~54 % of the photo). The car stays whole: the photo
     keeps its 4:5 ratio and is never cropped at the sides. The primary action
     comes right under the photo, so it is on the first screen even at 360x640;
     it never sits on the bodywork. Copy stays in DOM order for assistive tech
     (head, lede, actions); only the visual order of actions and lede changes. */
  @media (max-width: 760px) {
    .hero__stage {
      --top: calc(var(--header-h) + var(--demo-h) + env(safe-area-inset-top));
      position: relative; display: grid;
      grid-template-columns: var(--sc-gutter) minmax(0, 1fr) var(--sc-gutter);
    }
    .hero__copy { display: contents; }
    .hero__photo { grid-column: 1 / -1; grid-row: 1; padding-top: var(--top); background: var(--sc-canvas); }
    .hero__photo img {
      aspect-ratio: 1122 / 1402; object-fit: cover; object-position: 50% 100%;
      -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 24%);
      mask-image: linear-gradient(180deg, transparent 0, #000 24%);
    }
    /* Local scrim behind the title only (top of the photo), not a full-frame overlay. */
    .hero__photo::after {
      content: ''; position: absolute; inset: 0 0 auto; height: calc(var(--top) + 64%); pointer-events: none;
      background: linear-gradient(180deg, rgb(10 16 19 / 0.62) 0%, rgb(10 16 19 / 0.6) 66%, transparent 100%);
    }
    .hero__head {
      display: grid; gap: 0.5rem; justify-items: start; position: relative; z-index: 2;
      grid-column: 2; grid-row: 1; align-self: start; padding-top: calc(var(--top) + 0.9rem);
    }
    .hero__title { font-size: clamp(2.15rem, 1.2rem + 4.6vw, 3rem); text-shadow: 0 1px 18px rgb(10 16 19 / 0.45); }
    /* One line down to 360 px, so the title stays above the bright sunset band. */
    .hero__eyebrow { color: #e6eeec; font-size: min(0.72rem, 3.05vw); letter-spacing: 0.1em; white-space: nowrap; }
    /* The sunset clouds behind it are bright: light ink instead of the accent. */
    .hero__signature { color: #f4f6f4; text-shadow: 0 1px 12px rgb(10 16 19 / 0.6); }
    .hero__caption { position: static; grid-column: 2; grid-row: 1; align-self: end; justify-self: end; margin-bottom: 0.75rem; z-index: 2; }
    .hero__actions { grid-column: 2; grid-row: 2; margin-top: 1.25rem; }
    .hero__lede { grid-column: 2; grid-row: 3; margin-top: 1.1rem; }
    .hero__facts { grid-column: 2; grid-row: 4; margin-top: 0.9rem; }
    .hero__pv { grid-column: 2; grid-row: 5; }
    .hero__stage { padding-bottom: 2.25rem; }
  }

  /* ---------- LAYERED: wide landscape screens ---------- */
  @media (min-width: 1100px) and (min-aspect-ratio: 3/2) {
    .hero__stage { height: 100vh; height: 100svh; min-height: 40rem; overflow: clip; isolation: isolate; container-type: size; }
    .hero__photo { display: none; }
    .hero__media { display: block; position: absolute; inset: 0; z-index: 0; }
    /* Same frame for both planes ("cover"), shifted only as far as needed to keep
       the car's rear ~2.5 % inside the right edge, room for the end-of-scroll zoom. */
    .hero__frame {
      --w: max(100cqw, calc(100cqh * 1672 / 941));
      position: absolute; bottom: 0; aspect-ratio: 1672 / 941; width: var(--w);
      left: calc(-1 * max(0px, 0.97 * var(--w) - 100cqw));
    }
    /* Ultra-wide (2:1 and wider): "cover" would blow the car up under the copy.
       The frame is sized on the height instead, kept right, and its left edge
       fades into the dark ground the scrim already uses (the car starts at 32 %
       of the frame, the fade stops at 22 %). */
    @media (min-aspect-ratio: 2/1) {
      .hero__media { background: #0a1013; }
      .hero__frame {
        --w: calc(112cqh * 1672 / 941);
        left: calc(100cqw - 0.97 * var(--w));
        mask-image: linear-gradient(90deg, transparent 0, #000 22%);
      }
      /* The copy column sits further right on these screens: the scrim follows it
         (extra specificity: this block precedes the base scrim rule). */
      .hero__stage .hero__scrim {
        background:
          linear-gradient(180deg, rgb(10 16 19 / 0.7) 0%, rgb(10 16 19 / 0.35) 16%, transparent 34%),
          linear-gradient(98deg, rgb(10 16 19 / 0.88) 0%, rgb(10 16 19 / 0.82) 38%, rgb(10 16 19 / 0.45) 52%, transparent 66%);
      }
    }
    .hero__layer, .hero__layer img { position: absolute; inset: 0; width: 100%; height: 100%; }
    .hero__layer { transform-origin: 68.8% 88.8%; }
    .hero__scrim {
      display: block; position: absolute; inset: 0; z-index: 1; pointer-events: none;
      background:
        linear-gradient(180deg, rgb(10 16 19 / 0.7) 0%, rgb(10 16 19 / 0.35) 16%, transparent 34%),
        linear-gradient(98deg, rgb(10 16 19 / 0.88) 0%, rgb(10 16 19 / 0.8) 28%, rgb(10 16 19 / 0.4) 46%, transparent 62%);
    }
    /* Aligned with the header's brand pill; kept in the sky and left of the car's nose. */
    .hero__copy {
      position: absolute; inset: calc(var(--header-h) + var(--demo-h) + 3.5cqh) auto auto 0; margin: 0; max-width: none;
      padding: 0 0 0 max(var(--sc-gutter), calc((100cqw - var(--sc-maxw)) / 2 + var(--sc-gutter) / 2)); gap: 0.8rem;
    }
    .hero__title { font-size: clamp(2.6rem, 1.2rem + 2.5vw, 3.7rem); max-width: none; white-space: nowrap; }
    /* Narrower layered screens: two lines keep the title in the dark side of the scrim. */
    @media (max-width: 1299px) { .hero__title { white-space: normal; max-width: 12ch; } }
    /* Secondary action sits on the photo: a dark fill keeps its label readable whatever is behind it. */
    .hero__actions :global(.btn--ghost) { --b-bg: rgb(10 16 19 / 0.72); }
    .hero__lede { max-width: min(27rem, 30cqw); font-size: 1.12rem; }
    .hero__actions { max-width: min(28rem, 30cqw); }
    /* Narrow enough that every fact stays in the dark part of the scrim (EN runs longer). */
    .hero__facts { max-width: min(26rem, 20cqw); }
    .hero__caption { bottom: 1rem; }
  }

  @media (min-width: 1100px) and (min-aspect-ratio: 3/2) and (prefers-reduced-motion: no-preference) {
    .hero__layer--bg { transform: scale(calc(1 + var(--sc-p, 0) * 0.03)); }
    .hero__layer--car { transform: scale(calc(1 + var(--sc-p, 0) * 0.09)); }
  }
</style>
