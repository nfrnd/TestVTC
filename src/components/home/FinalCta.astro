---
import RouteMark from '../RouteMark.astro';
import type { Lang } from '../../content/types';
import { t } from '../../i18n';
import { quoteHref } from '../../i18n/routes';
import { routes } from '../../i18n/routes';
import { isDemo } from '../../content';
import ContactAction from '../ContactAction.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
---

<section class="final section ground-surface" aria-labelledby="final-title">
  <div class="wrap final__inner" data-sc-in data-sc-stagger="70">
    <RouteMark class="final__mark" />
    <h2 id="final-title" class="h-xl">{d.final.title}</h2>
    <p class="lede soft">{d.final.body}</p>
    <div class="btn-row">
      <a class="btn btn--primary" href={quoteHref(lang)}>{d.cta.quote}</a>
      <ContactAction kind="call" lang={lang} class="btn btn--ghost" />
      {isDemo && <a class="text-link" href={routes.contact[lang]}>{d.cta.seeContact}</a>}
    </div>
  </div>
</section>

<style>
  .final { overflow: hidden; }
  .final__inner { display: grid; gap: 1.5rem; justify-items: start; }
  .final__inner :global(.final__mark) { width: 4.5rem; height: auto; color: var(--sc-ink); }
  .final h2 { max-width: 14ch; }
  .final .btn-row { margin-top: 0.5rem; }
</style>
