---
// The site's mark: two stops joined by one calm arc, the same language as the
// route motif in Services. Decorative.
interface Props {
  class?: string;
}
---

<svg class={Astro.props.class} viewBox="0 0 32 20" aria-hidden="true" focusable="false">
  <path d="M4 15 C 10 3, 22 3, 28 11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
  <circle cx="4" cy="15" r="2.6" fill="currentColor"></circle>
  <circle cx="28" cy="11" r="3.4" fill="none" stroke="var(--sc-accent)" stroke-width="1.8"></circle>
</svg>
