---
import { business, demo, isDemo } from '../content';
import { known, type Lang } from '../content/types';
import { t } from '../i18n';
import { routes, quoteHref } from '../i18n/routes';
import { brandName, isPreview } from '../lib/site';
import RouteMark from './RouteMark.astro';
import ContactAction from './ContactAction.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const tel = known(business.phone);
const email = known(business.email);
const slogan = known(business.slogan);
---

<footer class="site-footer ground-dark">
  <div class="wrap">
    <div class="site-footer__grid">
      <div class="stack">
        <p class="brand" style="padding:0"><RouteMark /><span class="brand__name">{brandName(lang)}</span></p>
        {slogan && <p class="site-footer__slogan">{slogan[lang]}</p>}
        <p class="soft">{business.activity.value[lang]} · {business.city.value} · {lang === 'fr' ? 'Tesla Model 3 noire' : 'Black Tesla Model 3'}</p>
      </div>
      <ul>
        {isDemo && <li><a href={`${routes.home[lang]}#trajets`}>{d.nav.services}</a></li>}
        <li><a href={routes.rates[lang]}>{d.nav.rates}</a></li>
        <li><a href={quoteHref(lang)}>{d.cta.quote}</a></li>
        <li><a href={routes.contact[lang]}>{d.footer.contact}</a></li>
        {tel && <li><ContactAction kind="call" lang={lang} label={tel.display} /></li>}
        {email && <li class="site-footer__wide"><ContactAction kind="email" lang={lang} label={email} /></li>}
      </ul>
      <ul>
        <li><a href={routes.legal[lang]}>{d.footer.legal}</a></li>
        <li><a href={routes.privacy[lang]}>{d.footer.privacy}</a></li>
      </ul>
    </div>
    {demo ? (
      <p class="site-footer__small site-footer__demo">{demo.footer[lang]} {d.footer.illustration}</p>
    ) : (
      <p class="site-footer__small">{d.footer.illustration}</p>
    )}
    {isPreview && <p class="site-footer__small"><span class="pv">{d.preview.banner}</span></p>}
  </div>
</footer>

<style>
  .site-footer__slogan { font-family: var(--sc-font-display); font-size: 1.15rem; }
  .site-footer__demo { max-width: 62ch; }
  /* Phones: links in two columns instead of one long list (targets stay 44 px). */
  @media (max-width: 640px) {
    .site-footer ul { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1rem; }
    .site-footer__wide { grid-column: 1 / -1; }
  }
</style>
