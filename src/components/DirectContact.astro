---
// Direct channels. Live: confirmed details only, real links. Demo: fictional
// details, every action opens a simulation (ContactAction).
import { business, isDemo } from '../content';
import { known, type Lang } from '../content/types';
import { t } from '../i18n';
import PreviewNote from './PreviewNote.astro';
import ContactAction from './ContactAction.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const tel = known(business.phone);
const email = known(business.email);
const wa = known(business.whatsapp);
const any = tel || email || wa;
---

{any ? (
  <ul class="direct-list">
    {tel && <li><span>{d.contact.phone}{isDemo && (lang === 'fr' ? ' (fictif)' : ' (fictional)')}</span><ContactAction kind="call" lang={lang} label={tel.display} /></li>}
    {email && <li><span>{d.contact.email}{isDemo && (lang === 'fr' ? ' (fictif)' : ' (fictional)')}</span><ContactAction kind="email" lang={lang} label={email} /></li>}
    {wa && <li><span>WhatsApp{isDemo && (lang === 'fr' ? ' (fictif)' : ' (fictional)')}</span><ContactAction kind="whatsapp" lang={lang} label={d.cta.whatsappWrite} /></li>}
  </ul>
) : (
  <PreviewNote lang={lang} block note={d.quote.directPending} />
)}

<style>
  .direct-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25rem; }
  .direct-list li { display: grid; gap: 0.1rem; }
  .direct-list span { font-size: 0.82rem; color: var(--sc-ink-soft); }
  .direct-list :global(a) { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; font-size: 1.1rem; color: var(--focus); }
</style>
