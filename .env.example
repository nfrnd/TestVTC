# Copy to .env (local) or set in the hosting provider's dashboard. Never commit real values.

# --- Build-time -------------------------------------------------------------
# demo (default): fictional AZURÉA PRIVÉ scenario, simulated contacts and requests,
#   always noindex, SITE_ENV=production refused. live: the real business.
BUSINESS_MODE=demo
# preview (default): noindex everywhere + "À confirmer" annotations.
# production (live only): indexable; the build FAILS while critical business facts are unknown.
SITE_ENV=preview
# Canonical origin (no trailing slash). Must be the real domain in production.
SITE_URL=http://localhost:4321

# --- Runtime, server only (read by /api/demandes) ----------------------------
# In demo mode the email settings are ignored: requests are always simulated.
# test: validates and composes, sends nothing, says "simulated" (refused in production)
# resend: real delivery via https://resend.com   |   fail: always fails (to test errors)
EMAIL_TRANSPORT=test
RESEND_API_KEY=
# Recipient: the driver's validated address. Fixed server-side, never chosen by a visitor.
MAIL_TO=
# Sender on a domain verified with the provider, e.g. "Site VTC <demandes@example.fr>"
MAIL_FROM=
# Extra origins allowed to post (comma-separated), e.g. a preview URL.
ALLOWED_ORIGINS=
# true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Requests allowed per IP per window (in-memory, one process).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_S=600
